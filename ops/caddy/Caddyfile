# Caddy ingress for the opendevops LangGraph Server.
#
# The public API port. Caddy is the SOLE ingress — the langgraph-server container publishes no host
# port. The server's REST surface (threads / runs / stream / wait / cancel and metrics) is
# authenticated here. The three webhook routes and browser dashboard pass through without the
# gateway token because they implement native application authentication.
#
# Auth model: a STATIC BEARER TOKEN for the server API. CLI/Slack gateways send it as the server
# api_key. Webhook routes retain their own application-level authentication. The gateway token is
# injected from the environment as {$GATEWAY_TOKEN} (set in the compose env / .env).
#
# Upgrade path (deferred): swap this static-token gate for oauth2-proxy in front
# (OIDC / SSO, per-user identity, short-lived tokens) — reverse_proxy to oauth2-proxy:4180 and let
# it forward authenticated requests here. The gateway seam (ServerGateway) is unaffected: it keeps
# speaking the same HTTP surface, only the credential it presents changes.

:8123 {
	# Liveness probe passes through unauthenticated (no secrets on /healthz); everything else is gated.
	handle /healthz {
		reverse_proxy langgraph-server:8000
	}

	# Native webhook authentication happens in webapp.py:
	#   alertmanager + run-complete -> configured bearer token
	#   github                     -> HMAC-SHA256 signature
	@native_webhooks path /webhooks/alertmanager /webhooks/github /webhooks/run-complete
	handle @native_webhooks {
		reverse_proxy langgraph-server:8000
	}

	# Browser navigation cannot attach the server API bearer. The dashboard exchanges its own
	# configured login token for a short-lived signed HttpOnly cookie inside webapp.py.
	@dashboard path /dashboard /dashboard/*
	handle @dashboard {
		reverse_proxy langgraph-server:8000
	}

	@authorized header Authorization "Bearer {$GATEWAY_TOKEN}"
	handle @authorized {
		reverse_proxy langgraph-server:8000
	}

	# Deny everything else, fail-closed — never reveal whether a route exists.
	handle {
		respond "Unauthorized" 401
	}

	log {
		output stdout
		format console
	}
}
