# Caddy ingress for the opendevops LangGraph Server (P3, T18).
#
# The public API port. Caddy is the SOLE ingress — the langgraph-server container publishes no host
# port, so every external request is authenticated here before it reaches the server's REST surface
# (threads / runs / stream / wait / cancel) and the mounted webhook app.
#
# Auth model (PLAN §3.7): a STATIC BEARER TOKEN. Alertmanager sends it in its
# webhook_config.authorization; CLI/Slack gateways send it as the server api_key. A request whose
# `Authorization: Bearer <GATEWAY_TOKEN>` matches is proxied; anything else gets 401 (fail-closed).
# The token is injected from the environment as {$GATEWAY_TOKEN} (set in the compose env / .env).
#
# Upgrade path (deferred, see PLAN §3.7): swap this static-token gate for oauth2-proxy in front
# (OIDC / SSO, per-user identity, short-lived tokens) — reverse_proxy to oauth2-proxy:4180 and let
# it forward authenticated requests here. The gateway seam (ServerGateway) is unaffected: it keeps
# speaking the same HTTP surface, only the credential it presents changes.

:8123 {
	# Liveness probe passes through unauthenticated (no secrets on /healthz); everything else is gated.
	handle /healthz {
		reverse_proxy langgraph-server:8000
	}

	@authorized header Authorization "Bearer {$GATEWAY_TOKEN}"
	handle @authorized {
		reverse_proxy langgraph-server:8000
	}

	# Deny everything else, fail-closed — never reveal whether a route exists.
	handle {
		respond "Unauthorized" 401
	}

	log {
		output stdout
		format console
	}
}
