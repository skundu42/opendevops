# Copy to .env and fill in. Values here are layered by pydantic-settings (config.py).

# Required for live agent runs (never passed into the child subprocess env).
ANTHROPIC_API_KEY=

# Required by docker-compose.yml. There are deliberately no default service credentials.
POSTGRES_PASSWORD=
GATEWAY_TOKEN=
GRAFANA_ADMIN_PASSWORD=
# Local-development dashboard login only. Production deployments should use OIDC.
DASHBOARD_TOKEN=

# OIDC dashboard login (recommended outside local development). These are examples; configure the
# environment variable NAMES in server.oidc and place only their values here/your secret manager.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Optional OTLP/HTTP export. Without an endpoint the OpenTelemetry API remains a safe no-op.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# Optional — LangSmith tracing (observability). Leave unset to disable.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
