# Image used by docker-compose. Release bundles pin this to their exact version.
LANGGRAPH_IMAGE=ghcr.io/skundu42/opendevops:latest

# Required for service mode. Empty values deliberately make Compose refuse to start.
POSTGRES_PASSWORD=
GATEWAY_TOKEN=
GRAFANA_ADMIN_PASSWORD=
ANTHROPIC_API_KEY=
LANGSMITH_API_KEY=

# Optional Slack profile (Socket Mode).
OPENDEVOPS_SLACK_BOT_TOKEN=
OPENDEVOPS_SLACK_APP_TOKEN=

# Optional scheduler profile. URI must remain passwordless; PGPASSWORD carries the secret.
OPENDEVOPS_BACKUP_DATABASE_URI=postgresql://postgres@postgres:5432/postgres?sslmode=disable
OPENDEVOPS_BACKUP_DIR=/backups
# Standalone scheduler only; Compose maps POSTGRES_PASSWORD to PGPASSWORD inside the container.
PGPASSWORD=

# Local-development dashboard authentication. Use OIDC in production.
DASHBOARD_TOKEN=

# Production dashboard OIDC settings.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Optional OTLP/HTTP endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional LangSmith tracing. Leave false to disable application traces.
LANGSMITH_TRACING=false
